fish is a shell
csh is not a shell
-- bash, flags of a record
# bash completion for my-tool (generated by command.completion): `source` it, or save it in a bash-completion directory
_my_tool() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    COMPREPLY=()
    COMPREPLY=( $(compgen -W '--addr --workers -w --verbose -v --no-verbose --limit --help -h' -- "$cur") )
}
complete -F _my_tool my-tool
-- zsh, flags of a record
#compdef my-tool
# zsh completion for my-tool (generated by command.completion): save it as _my-tool in a directory of your fpath, or `source` it after compinit
_my_tool() {
    _arguments '--addr[address to listen on (default :8080)]:text:' '--workers[worker tasks (default 4)]:integer:' '-w[worker tasks (default 4)]:integer:' '--verbose[log every request]' '-v[log every request]' '--no-verbose[log every request]' '--limit:unsigned integer:' '--help[print help]' '-h[print help]'
}
if [ "$funcstack[1]" = "_my_tool" ]; then
    _my_tool "$@"
else
    compdef _my_tool my-tool
fi
-- fish, flags of a record
# fish completion for my-tool (generated by command.completion): save it as ~/.config/fish/completions/my-tool.fish
complete -c my-tool -l addr -d 'address to listen on' -r
complete -c my-tool -s w -l workers -d 'worker tasks' -r
complete -c my-tool -s v -l verbose -d 'log every request'
complete -c my-tool -l no-verbose
complete -c my-tool -l limit -r
complete -c my-tool -s h -l help -d 'print help'
-- bash, subcommands
# bash completion for tool (generated by command.completion): `source` it, or save it in a bash-completion directory
_tool() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    COMPREPLY=()
    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=( $(compgen -W 'serve migrate-up help --help -h' -- "$cur") )
        return
    fi
    case "${COMP_WORDS[1]}" in
        serve) COMPREPLY=( $(compgen -W '--addr --workers -w --help -h' -- "$cur") ) ;;
        migrate-up) COMPREPLY=( $(compgen -W '--steps --dry-run --no-dry-run --help -h' -- "$cur") ) ;;
        help) COMPREPLY=( $(compgen -W 'serve migrate-up' -- "$cur") ) ;;
    esac
}
complete -F _tool tool
-- zsh, subcommands
#compdef tool
# zsh completion for tool (generated by command.completion): save it as _tool in a directory of your fpath, or `source` it after compinit
_tool() {
    local -a cmds
    cmds=(
        'serve:run the server'
        'migrate-up:apply migrations'
        'help:print the help of a command'
    )
    if (( CURRENT == 2 )); then
        _describe -t commands 'tool command' cmds
        return
    fi
    case $words[2] in
        serve) _arguments '--addr:text:' '--workers[(default 2)]:integer:' '-w[(default 2)]:integer:' '--help[print help]' '-h[print help]' ;;
        migrate-up) _arguments '--steps:integer:' '--dry-run' '--no-dry-run' '--help[print help]' '-h[print help]' ;;
        help) _describe -t commands 'tool command' cmds ;;
    esac
}
if [ "$funcstack[1]" = "_tool" ]; then
    _tool "$@"
else
    compdef _tool tool
fi
-- fish, subcommands
# fish completion for tool (generated by command.completion): save it as ~/.config/fish/completions/tool.fish
complete -c tool -f
complete -c tool -n __fish_use_subcommand -a serve -d 'run the server'
complete -c tool -n __fish_use_subcommand -a migrate-up -d 'apply migrations'
complete -c tool -n __fish_use_subcommand -a help -d 'print the help of a command'
complete -c tool -n '__fish_seen_subcommand_from serve' -l addr -r
complete -c tool -n '__fish_seen_subcommand_from serve' -s w -l workers -r
complete -c tool -n '__fish_seen_subcommand_from serve' -s h -l help -d 'print help'
complete -c tool -n '__fish_seen_subcommand_from migrate-up' -l steps -r
complete -c tool -n '__fish_seen_subcommand_from migrate-up' -l dry-run
complete -c tool -n '__fish_seen_subcommand_from migrate-up' -l no-dry-run
complete -c tool -n '__fish_seen_subcommand_from migrate-up' -s h -l help -d 'print help'
complete -c tool -n '__fish_seen_subcommand_from help' -a 'serve migrate-up'
complete -c tool -n __fish_use_subcommand -s h -l help -d 'print help'
-- help <command>
true
Usage: tool migrate-up [flags] [--] [args...]
a tool

Flags:
      --steps <integer>
      --dry-run
  -h, --help                  print this help
-- help alone is the command list
Usage: tool <command> [--] [args...]
a tool

Commands:
  serve             run the server
  migrate-up        apply migrations

Flags:
  -h, --help                  print this help
